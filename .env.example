# ============================================================
# Telegram File Deliver Bot — environment variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# Never commit your real .env file.
# ============================================================

# ------------------------------------------------------------
# REQUIRED — the bot refuses to start if any of these are invalid
# ------------------------------------------------------------

# Bot token from @BotFather (format: 123456789:AAxxxxxxxx...)
TELEGRAM_TOKEN=

# MongoDB connection string (must start with mongodb:// or mongodb+srv://)
# The database name "TelegramMovies" is set in code, so you don't need one in the URI.
MONGODB_URI=

# Numeric ID of the private storage channel (e.g. -1001234567890)
# The bot must be an admin there (post + edit messages).
STORAGE_CHANNEL_ID=

# Public HTTPS URL of your deployment (no trailing slash needed).
# Telegram webhooks require HTTPS. Also used by the keep-alive self-ping.
# Local dev: use your ngrok URL.
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# ------------------------------------------------------------
# ADMINS
# ------------------------------------------------------------

# Comma-separated numeric Telegram user IDs with admin access.
# Leave empty to run with no admins (admin commands will be unusable).
ADMIN_IDS=

# ------------------------------------------------------------
# FORCE JOIN (optional) — leave FORCE_CHANNEL_ID empty to disable
# ------------------------------------------------------------

# Channel users must join before using the bot: "@channelusername" or a numeric ID (-100...).
# The bot must be an admin in this channel to verify membership.
FORCE_CHANNEL_ID=

# Permanent invite link shown on the "Join Channel" button (https://t.me/...).
# Recommended when FORCE_CHANNEL_ID is numeric / the channel is private.
# If empty, the bot creates one link and stores it in MongoDB.
FORCE_CHANNEL_LINK=

# ------------------------------------------------------------
# SECURITY (optional)
# ------------------------------------------------------------

# Secret for the webhook URL path and Telegram's secret-token header.
# 16-256 characters: A-Z a-z 0-9 _ -
# If empty, a stable secret is derived from your bot token.
WEBHOOK_SECRET=

# ------------------------------------------------------------
# LIMITS & PAGINATION (optional — defaults shown)
# ------------------------------------------------------------

# Max downloads per user per day (resets at midnight UTC). Range: 1-100000
DAILY_LIMIT=100

# Search results shown per page. Range: 1-50
RESULTS_PER_PAGE=10

# Max favorites per user. Range: 1-1000
FAV_LIMIT=50

# Items listed by /trending and /recent. Range: 1-50
TRENDING_LIMIT=10
RECENT_LIMIT=10

# Minimum word length used for fuzzy (prefix) search fallback. Range: 1-20
FUZZY_MIN_WORD_LEN=3

# Days to keep daily-limit records before MongoDB removes them. Range: 1-365
LIMIT_DOC_TTL_DAYS=2

# ------------------------------------------------------------
# AUTO-DELETE & COOLDOWNS, in milliseconds (optional — defaults shown)
# Delete range: 1000-172800000 (Telegram can't delete messages older than 48h)
# ------------------------------------------------------------

# Delay before delivered files / private result messages are deleted
PRIVATE_AUTO_DELETE_MS=60000

# Delay before bot replies in groups are deleted
GROUP_AUTO_DELETE_MS=60000

# Delay before "no results" messages are deleted
NO_RESULT_DELETE_MS=60000

# Minimum gap between bot responses per group chat. 0 disables. Range: 0-3600000
GROUP_COOLDOWN_MS=2000

# ------------------------------------------------------------
# SERVER (optional)
# ------------------------------------------------------------

# HTTP port. Render sets this automatically — usually leave it alone.
PORT=3000
