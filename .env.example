# ============================================================
# REQUIRED — Bot will not start without these
# ============================================================

# Your bot token from @BotFather
TELEGRAM_TOKEN=

# MongoDB connection string from Atlas
MONGODB_URI=

# The channel where files are physically stored (bot must be admin)
# Use numeric ID format: -100xxxxxxxxxx
STORAGE_CHANNEL_ID=

# Your Render service external URL (no trailing slash)
# Example: https://your-bot-name.onrender.com
RENDER_EXTERNAL_URL=

# Comma-separated Telegram user IDs with admin access
# Example: 123456789,987654321
ADMIN_IDS=

# Force users to join a channel before using the bot
# Use @username format (recommended) or numeric ID (-100xxxxxxxxxx)
FORCE_CHANNEL_ID=
